# Reference for every setting. In production these come from GitHub repo variables/secrets
# and are rendered to /etc/agents/unifi-agent.env on deploy; use this file for local runs.

# --- Required ---
# The UniFi MCP server (github.com/enuno/unifi-mcp-server) over Streamable HTTP, with every read-only
# tool (no UNIFI_PROFILE, or "all"), and this agent's own bearer token on it: one of the entries in
# the server's MCP_AUTH_TOKEN, ideally viewer:<token>. The agent sends the token part only.
UNIFI_MCP_URL=http://192.0.2.10:3000/mcp
UNIFI_MCP_TOKEN=
UNIFI_SITE=default

# --- Alerts (checked every POLL_MINUTES) ---
POLL_MINUTES=5
# A device not ONLINE, or the server unreachable, for this long is reported (restarts and updates aren't)
DEVICE_GRACE_MINUTES=10
# An event in UniFi's log is an error when its severity is one of these...
ALERT_SEVERITIES=HIGH,VERY_HIGH,CRITICAL
# ...or its name matches this (case-insensitive), outside IGNORE_CATEGORIES
ALERT_EVENTS=LOST|DOWN|FAIL|ERROR|OFFLINE|DISCONNECTED|ISOLATED|RESTART|REBOOT|FAILOVER|THREAT|INTRUSION|IPS_|OVERHEAT|POE_OVERLOAD
IGNORE_CATEGORIES=CLIENT_DEVICES

# --- Weekly recommendations ---
TIMEZONE=America/New_York
DIGEST_DAY=sun
DIGEST_TIME=09:00
# Networks (by name) that must not sit in the Internal zone with the main LAN
ISOLATE_NETWORKS=iot|camera|guest|lab
BACKUP_MAX_DAYS=7
# Accept recommendations as they are: a rule id (wifi.pmf) or one target (wifi.wpa3:IoT WiFi)
ADVICE_IGNORE=

# AI write-up of the digest via OpenCode Go (opencode.ai/go). Empty key: the rules' own wording only.
OPENCODE_API_KEY=
OPENCODE_MODEL=glm-5.2
# Free text the write-up should know, e.g. "IoT SSID must stay WPA2 for old plugs"
NETWORK_NOTES=

# Apprise URLs, comma separated: discord://webhook_id/webhook_token   ntfy://ntfy.sh/topic
NOTIFY_URLS=
RENOTIFY_HOURS=24

# Agent bus (MCP for an assistant such as Hermes): a long random token; empty turns it off
AGENT_BUS_TOKEN=
AGENT_BUS_PORT=8765
BOT_ALERT_URL=
