# Generated by dockerfile-agent from: deploy/lxc/unifi-agent-install, deploy/lxc/bootstrap-agent.sh, requirements.txt, unifi_agent/config.py, unifi_agent/health.py.
# Don't edit by hand: it's regenerated whenever those files change. Change them instead.
#
# Build: docker build --pull --build-arg PATCHED_AT=$(date +%s) --build-arg REVISION=$(git rev-parse HEAD) -t unifi-agent .
# Run:   docker run -d --name unifi-agent --restart unless-stopped \
#     --env-file agent.env \
#     -v unifi-agent-data:/var/lib/unifi-agent \
#     -p 8765:8765 \
#     unifi-agent
#
# agent.env holds the settings in .env.example (the deploy workflow renders it from repo variables and secrets).

FROM python:3.13-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
ENV TZ=America/New_York

ARG DEBIAN_FRONTEND=noninteractive
ARG PATCHED_AT=unknown
RUN echo "Patching the base OS ($PATCHED_AT)" \
 && apt-get update \
 && apt-get -y full-upgrade \
 && apt-get install -y --no-install-recommends ca-certificates tzdata \
 && ln -snf "/usr/share/zoneinfo/$TZ" /etc/localtime && echo "$TZ" > /etc/timezone \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN groupadd --system unifi-agent \
 && useradd --system --gid unifi-agent --home-dir /var/lib/unifi-agent --shell /usr/sbin/nologin unifi-agent \
 && install -d -o unifi-agent -g unifi-agent /var/lib/unifi-agent

WORKDIR /opt/unifi-agent/app
COPY requirements.txt ./
RUN pip install -r requirements.txt
COPY unifi_agent/ ./unifi_agent/
ARG REVISION=unknown
RUN echo "$REVISION" > REVISION

ENV STATE_PATH=/var/lib/unifi-agent/state.json
USER unifi-agent
VOLUME ["/var/lib/unifi-agent"]
EXPOSE 8765
HEALTHCHECK --interval=60s --timeout=15s --start-period=2m --retries=5 \
  CMD ["python", "-m", "unifi_agent.health"]
CMD ["python", "-m", "unifi_agent"]
